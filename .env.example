# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it, never paste its contents in chat.
# For GitHub Actions: add each variable as a repo secret (Settings → Secrets → Actions).
# For Toolforge: `toolforge envvars create <NAME>` for each one.

# ── 1. Wikimedia Enterprise Realtime API (Phase 1+) ─────────────────────
# Source: https://dashboard.enterprise.wikimedia.com/ (your account)
# Used for: SSE streaming of portal changes
WIKI_ENTERPRISE_USERNAME=
WIKI_ENTERPRISE_PASSWORD=

# ── 2. Wikidata bot OAuth (Phase 4+, after BRFA) ────────────────────────
# Source: register an owner-only OAuth 2.0 consumer at
#   https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose
# Used for: writing edits to Wikidata under the bot account
# Leave blank until the bot account is registered (Phase 0 step 4–5).
WIKIDATA_OAUTH_CLIENT_ID=
WIKIDATA_OAUTH_CLIENT_SECRET=
WIKIDATA_OAUTH_ACCESS_TOKEN=

# ── 3. Anthropic API (Phase 2, only if Liftwing probe finds no fit) ─────
# Source: https://console.anthropic.com/settings/keys
# Used for: structured-output newsworthiness scoring
ANTHROPIC_API_KEY=

# ── 4. Discord application (Phase 2+) ───────────────────────────────────
# Source: https://discord.com/developers/applications
# Create application → Bot → Reset Token (copy once)
# Permissions: Send Messages, Use Slash Commands, Embed Links
# Used for: posting notifications, slash commands, review/approve flow
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Discord routing — once your server is set up, get IDs by enabling Developer
# Mode in Discord (User Settings → Advanced) and right-clicking server/channel.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_NOTIFICATIONS=
DISCORD_CHANNEL_REVIEW=
DISCORD_CHANNEL_ERRORS=

# ── 5. Postgres (Phase 1+) ──────────────────────────────────────────────
# Recommended: Neon free tier — https://neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ── 6. Sentry (optional — error tracking) ──────────────────────────────
# Source: https://sentry.io (free tier)
# Skip if you'd rather rely on Discord error notifications only.
SENTRY_DSN=

# ── Internal flags ──────────────────────────────────────────────────────
# Set DRY_RUN=true to run scorer + writer without actually publishing to
# Wikidata. Default until Phase 5 is enabled.
DRY_RUN=true
LOG_LEVEL=INFO
